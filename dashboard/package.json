{
  "name": "backend-dashboard",
  "version": "1.6.0",
  "private": true,
  "description": "Local dashboard for the backend Claude Code plugin: .plans/ browser, skill wizards, live Claude Code sessions in tabs, and git worktrees with their own backend, frontend and database.",

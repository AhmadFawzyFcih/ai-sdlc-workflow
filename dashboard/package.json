  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.2.0",
    "marked": "^15.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  }
}
